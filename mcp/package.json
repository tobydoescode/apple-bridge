{
  "name": "@evoio/apple-bridge-mcp",
  "version": "1.0.0",
  "description": "MCP server for managing Apple Reminders and Calendars via EventKit",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "apple-bridge-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run build",
    "test": "node --test test/*.test.js",
    "start": "node dist/index.js",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "apple",
    "reminders",
    "calendars",
    "eventkit",
    "macos"
  ],
  "author": "tpettit",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tobydoescode/apple-bridge.git"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "typescript": "^7.0.0"
  }
}
